# OpenAI-compatible endpoint (any local LLM server: Ollama, LM Studio, llama.cpp server, vLLM...)
LLM_BASE_URL=http://basement.tail7452e.ts.net:8189/v1
LLM_MODEL=halogen-qwen3.8-flash-next
# Optional API key (many local servers don't need one)
LLM_API_KEY=

# Model to use for image transcription (must be vision-capable).
# Defaults to LLM_MODEL if unset.
VISION_MODEL=

# Server port (inside and outside the container)
PORT=8888

# Max upload size for images (e.g. 10mb)
MAX_UPLOAD=10mb

# Number of flashcards to generate per study guide
CARD_COUNT=15
